{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "flow_manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["side", "provenance", "emitted_utc", "nodes", "edges"],
  "properties": {
    "side": { "enum": ["source", "target"] },
    "provenance": { "enum": ["static", "dynamic"] },
    "emitted_utc": { "type": "string" },
    "nodes": {
      "type": "array", "minItems": 1,
      "items": { "type": "object", "additionalProperties": false,
        "required": ["id", "kind", "label"],
        "properties": {
          "id": { "type": "string" },
          "kind": { "enum": ["module", "object"] },
          "label": { "type": "string" } } }
    },
    "edges": {
      "type": "array",
      "items": { "type": "object", "additionalProperties": false,
        "required": ["from", "to", "kind"],
        "properties": {
          "from": { "type": "string" },
          "to": { "type": "string" },
          "kind": { "enum": ["PRODUCE", "READ"] } } }
    },
    "notes": { "type": "array", "items": { "type": "string" } }
  }
}
