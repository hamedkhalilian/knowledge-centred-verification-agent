{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "runtime_trace",
  "type": "object",
  "additionalProperties": false,
  "required": ["run_id", "side", "emitted_utc", "stages", "completeness"],
  "properties": {
    "run_id": { "type": "string" },
    "side": { "enum": ["source", "target"] },
    "emitted_utc": { "type": "string" },
    "jvm": { "type": "object", "additionalProperties": false,
      "properties": { "version": {"type": "string"}, "max_heap_bytes": {"type": "integer"},
        "declared_release": {"type": "integer"} } },
    "stages": {
      "type": "array",
      "items": { "type": "object", "additionalProperties": false,
        "required": ["name", "ms"],
        "properties": {
          "name": { "type": "string" },
          "start_utc": { "type": "string" },
          "ms": { "type": "integer" },
          "progress_events": { "type": "integer" },
          "rows_processed": { "type": "integer" },
          "exceptions": { "type": "array", "items": { "type": "object", "additionalProperties": false,
            "required": ["type", "message"],
            "properties": { "type": {"type": "string"}, "message": {"type": "string"}, "at": {"type": "string"} } } },
          "effects": { "type": "array", "items": { "type": "object", "additionalProperties": false,
            "required": ["kind"],
            "properties": { "kind": { "enum": ["file_write", "file_read", "dialog", "process", "render"] },
              "path": {"type": "string"}, "note": {"type": "string"} } } }
        } }
    },
    "completeness": {
      "type": "object", "additionalProperties": false,
      "required": ["complete", "missing"],
      "properties": {
        "complete": { "type": "boolean" },
        "missing": { "type": "array", "items": { "type": "string" } } }
    }
  }
}
